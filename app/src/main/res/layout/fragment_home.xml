<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            style="@style/Text.Hero" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/home_subtitle"
            style="@style/Text.Caption" />

        <!-- Module status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_status_title"
                style="@style/Text.Headline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/home_status_checking"
                    style="@style/Text.Body" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text=""
                style="@style/Text.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/home_feature_status_title"
                style="@style/Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/home_feature_status_hint"
                style="@style/Text.Caption" />

            <LinearLayout
                android:id="@+id/featureStatusList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 悬浮窗（统一入口：主页最上方管理两种模式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_float_title"
                style="@style/Text.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/home_float_desc"
                style="@style/Text.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/floatWindowButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/float_open"
                    style="@style/Button.Pill" />

                <Button
                    android:id="@+id/closeFloatButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/float_close_window"
                    style="@style/Button.Pill.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 一键采集卡（快照/录像选项卡） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_collect_title"
                style="@style/Text.Headline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/collectTabSnapshot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/home_collect_tab_snapshot"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/collectTabRecording"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_secondary"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/home_collect_tab_recording"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- 快照模式 -->
            <LinearLayout
                android:id="@+id/snapshotPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/home_collect_desc"
                    style="@style/Text.Caption" />

                <Button
                    android:id="@+id/collectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/home_collect_button"
                    style="@style/Button.Pill" />

                <TextView
                    android:id="@+id/collectResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text=""
                    android:fontFamily="monospace"
                    android:textSize="@dimen/text_tiny"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    tools:text="采集结果" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:background="@color/separator" />

                <EditText
                    android:id="@+id/collectNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/home_collect_name_hint"
                    style="@style/EditText.Field" />

                <EditText
                    android:id="@+id/collectRemarkInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:hint="@string/home_collect_remark_hint"
                    style="@style/EditText.Field" />

                <Button
                    android:id="@+id/saveCollectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/home_collect_save"
                    style="@style/Button.Pill.Secondary" />
            </LinearLayout>

            <!-- 录像模式 -->
            <LinearLayout
                android:id="@+id/recordingPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/home_recording_desc"
                    style="@style/Text.Caption" />

                <EditText
                    android:id="@+id/recordingNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/home_recording_name_hint"
                    style="@style/EditText.Field" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/recordingIntervalInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/home_recording_interval_hint"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        style="@style/EditText.Field" />

                    <Button
                        android:id="@+id/recordingStartButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_recording_start"
                        style="@style/Button.Pill" />

                    <Button
                        android:id="@+id/recordingStopButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_recording_stop"
                        style="@style/Button.Pill.Secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/recordingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text=""
                    style="@style/Text.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- 采集回放卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_playback_title"
                style="@style/Text.Headline" />

            <TextView
                android:id="@+id/playbackSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/home_playback_none"
                style="@style/Text.Caption" />

            <Button
                android:id="@+id/playbackEnableButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/home_playback_enable"
                style="@style/Button.Pill" />

            <!-- 录像控制（仅录像选中时显示）：2 行 × 2 列等大矩形网格 -->
            <LinearLayout
                android:id="@+id/playbackControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/playbackPauseButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_playback_pause"
                        style="@style/Button.Pill.Secondary" />

                    <Button
                        android:id="@+id/playbackResumeButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_playback_resume"
                        style="@style/Button.Pill.Secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/playbackRestartButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_playback_restart"
                        style="@style/Button.Pill.Secondary" />

                    <Button
                        android:id="@+id/playbackStopButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/home_playback_stop"
                        style="@style/Button.Pill.Secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/playbackSpeedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_playback_speed"
                    style="@style/Text.Caption" />

                <EditText
                    android:id="@+id/playbackSpeedInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:hint="@string/home_playback_speed_hint"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    style="@style/EditText.Field" />

                <Button
                    android:id="@+id/playbackSpeedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="0dp"
                    android:text="@string/home_playback_speed_set"
                    style="@style/Button.Pill.Secondary" />

                <CheckBox
                    android:id="@+id/playbackLoopCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="0dp"
                    android:checked="true"
                    android:text="@string/home_playback_loop"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/playbackStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text=""
                style="@style/Text.Caption" />
        </LinearLayout>

        <!-- 已保存采集（快照 + 录像统一列表） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_saved_title"
                style="@style/Text.Headline" />

            <TextView
                android:id="@+id/savedCollectEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/home_saved_empty"
                android:textColor="@color/text_secondary"
                style="@style/Text.Caption" />

            <LinearLayout
                android:id="@+id/savedCollectList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
