<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass bottom bar: translucent fill + top highlight + hairline border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tab_bar_radius" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tab_bar_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_fill"
                android:startColor="@color/glass_highlight" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
