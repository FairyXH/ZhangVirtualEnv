<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃面板：半透明玻璃底 + 顶部高光 + 细描边 + 阴影，随深浅色 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- 顶部受光高光 -->
    <item
        android:bottom="90dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/radius_card"
                android:topRightRadius="@dimen/radius_card" />
            <gradient
                android:type="linear"
                android:angle="-90"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
