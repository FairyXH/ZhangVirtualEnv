<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-style card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/card_border" />
        </shape>
    </item>
</layer-list>
