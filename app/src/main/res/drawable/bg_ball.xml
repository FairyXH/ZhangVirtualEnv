<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃悬浮球：半透明玻璃底 + 顶部径向高光 + 细描边 + 内环图标，随深浅色 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.32"
                android:centerY="0.22"
                android:gradientRadius="20dp"
                android:startColor="@color/glass_ball_highlight"
                android:centerColor="@color/glass_fill"
                android:endColor="@color/glass_ball_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- 内圈：白环图标，无需文字 -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2.5dp"
                android:color="@color/glass_ball_ring" />
        </shape>
    </item>
</layer-list>
