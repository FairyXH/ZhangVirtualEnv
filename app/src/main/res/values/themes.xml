<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZVirtualEnv" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.ZVirtualEnv.Night" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Apple-style text appearances -->
    <style name="Text.Hero" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Headline" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Caption" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Card -->
    <style name="Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- Pill button -->
    <style name="Button.Pill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/bg_secondary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
    </style>

    <!-- Secondary pill (glass) -->
    <style name="Button.Pill.Secondary" parent="">
        <item name="android:background">@drawable/bg_pill_secondary</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
    </style>

    <!-- Input field -->
    <style name="EditText.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
</resources>
