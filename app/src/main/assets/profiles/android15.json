{
  "name": "android15",
  "android": 15,
  "minSdk": 35,
  "maxSdk": 99,
  "device": "*",
  "hooks": {
    "location": {
      "managerClass": "com.android.server.location.LocationManagerService",
      "getLastLocation": "getLastLocation",
      "getCurrentLocation": "getCurrentLocation",
      "gnssClass": "com.android.server.location.gnss.GnssLocationProvider",
      "reportLocation": "onReportLocation",
      "providerManagerClass": "com.android.server.location.provider.LocationProviderManager",
      "managerReportLocation": "onReportLocation",
      "injectProviders": ["gps", "passive"],
      "injectIntervalMs": 1000
    }
  }
}
