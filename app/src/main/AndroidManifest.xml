<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 控制端 / Backend HTTP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 桌面壁纸背景：ColorOS 的 WallpaperManager 读取壁纸位图检查
         READ_EXTERNAL_STORAGE（targetSdk=32 时该权限可授予） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 定位 / 地图 / 采集 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- WiFi 采集 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- 基站采集 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 传感器模拟/内置检测：计步器与步态传感器注册需要（Android 10+ 强制） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 蓝牙 / BLE 采集 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 悬浮窗摇杆 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:name=".App"
        android:description="@string/module_description"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZVirtualEnv"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/logo"
        tools:ignore="MissingApplicationIcon">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="uiMode|orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- 模块设置入口：LSPosed 通过 MODULE_SETTINGS 打开；桌面图标由 Launcher 别名控制 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标别名：默认显示；设置页开启“隐藏桌面图标”后禁用此别名即可隐藏，
             主 Activity 本身保持可用，仍可从 LSPosed 模块界面打开 -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".app.MainActivity"
            android:exported="true"
            android:enabled="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".app.ui.EnvDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.ui.RemoteEnvironmentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.ui.RecordingDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 全局崩溃报告弹窗（透明，不依赖主界面） -->
        <activity
            android:name=".app.CrashReportActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Dialog" />

        <service
            android:name=".app.FloatControlService"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false"
            android:foregroundServiceType="location|connectedDevice" />

        <service
            android:name=".app.AppKeepAliveService"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false"
            android:foregroundServiceType="location|connectedDevice" />
    </application>
</manifest>
